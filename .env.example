# Kopiere diese Datei zu ".env" und trage echte Werte ein.
# Die echte ".env" darf NIE in Git landen (steht in .gitignore).

# Verbindung zur PostgreSQL-Datenbank. Format: postgresql://BENUTZER:PASSWORT@HOST:5432/DATENBANKNAME
DATABASE_URL="postgresql://johndoe:randompassword@localhost:5432/fahrdienst_ki?schema=public"
# Nur für "prisma migrate" (prisma7.config.ts): bei Neon die UNGEPOOLTE Verbindung (ohne "-pooler").
# Lokal leer lassen, dann gilt DATABASE_URL.
DIRECT_URL=

# Geheimer Schlüssel für die Anmeldung (Better Auth). Erzeugen mit: npx auth secret
AUTH_SECRET=

# Resend (https://resend.com) zum Versenden der Einmal-Codes an das Büro (ADMIN/DISPONENT).
# In Produktion Pflicht – ohne Schlüssel startet der Server nicht (src/lib/umgebung.ts).
RESEND_API_KEY=

# Zugang zum Voice-Anbieter Vapi (KI am Telefon). Kommt erst in Phase 6 zum Einsatz.
VAPI_API_KEY=
# Geheimnis, mit dem Vapi seine Webhook-Anfragen signiert, damit wir Fälschungen erkennen.
VAPI_WEBHOOK_SECRET=

# Zugang zu Claude (console.anthropic.com, eigenes Konto, nicht dasselbe wie Claude Code) für die
# Gesprächs-Zusammenfassung und den Text-Chat-Simulator "npm run voice:sim". Ohne diesen Schlüssel
# läuft alles weiter, nur ohne echte KI-Zusammenfassung bzw. ohne voice:sim.
ANTHROPIC_API_KEY=

# Zugang zu OpenRouteService (Geocoding und Fahrzeiten). Kommt in Phase 3 zum Einsatz.
ORS_API_KEY=

# Zugang zum SMS-Anbieter (EU) für Fahrer-Anmelde-Link, Fahrer-Rückfall und Alarme. Der Anbieter ist
# noch nicht gewählt (Entscheidung des Auftraggebers); bis dahin wird der Schlüssel nicht gelesen und
# jeder SMS-Versand in Produktion scheitert mit klarer Meldung (src/providers/sms/index.ts).
SMS_API_KEY=

# Schlüsselpaar für Web-Push an die Fahrer-App. Erzeugen z. B. mit: npx web-push generate-vapid-keys
# In Produktion Pflicht (alle drei Werte).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Derselbe Wert wie VAPID_PUBLIC_KEY, aber mit NEXT_PUBLIC_-Präfix, damit ihn der Browser lesen darf.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Schlüssel zum Verschlüsseln von Gesprächsprotokollen und Zugangsdaten (AES-256-GCM, genau 32 Byte).
# Erzeugen z. B. mit: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Geheimnis, das die Cron-Endpunkte (/api/cron/*) vor fremden Aufrufen schützt.
CRON_SECRET=

# Die öffentliche Adresse der App, z. B. http://localhost:3000 in der Entwicklung
# oder https://meine-domain.de im Betrieb.
APP_URL=http://localhost:3000

# Fehler-Monitoring (Sentry, docs/12-betrieb.md). Ohne gesetzten Wert läuft die App normal
# weiter, nur ohne Fehlermeldungen an Sentry. SENTRY_DSN und NEXT_PUBLIC_SENTRY_DSN sind derselbe
# Wert (einmal für den Server, einmal für den Browser – wie bei VAPID oben).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Nur für den Build auf Vercel nötig (lädt Source-Maps hoch, damit Fehler auf echten Code statt
# minifizierten Build-Code zeigen). In Vercel unter Project Settings → Environment Variables setzen.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
