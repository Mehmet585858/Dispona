# Kopiere diese Datei zu ".env" und trage echte Werte ein.
# Die echte ".env" darf NIE in Git landen (steht in .gitignore).

# Verbindung zur PostgreSQL-Datenbank. Format: postgresql://BENUTZER:PASSWORT@HOST:5432/DATENBANKNAME
DATABASE_URL="postgresql://johndoe:randompassword@localhost:5432/fahrdienst_ki?schema=public"

# Geheimer Schlüssel für die Anmeldung (Better Auth). Erzeugen mit: npx auth secret
AUTH_SECRET=

# Mailserver zum Versenden der Einmal-Codes an das Büro (ADMIN/DISPONENT).
# Format: smtp://BENUTZER:PASSWORT@HOST:PORT
EMAIL_SERVER=

# Zugang zum Voice-Anbieter Vapi (KI am Telefon). Kommt erst in Phase 6 zum Einsatz.
VAPI_API_KEY=
# Geheimnis, mit dem Vapi seine Webhook-Anfragen signiert, damit wir Fälschungen erkennen.
VAPI_WEBHOOK_SECRET=

# Zugang zu OpenRouteService (Geocoding und Fahrzeiten). Kommt in Phase 3 zum Einsatz.
ORS_API_KEY=

# Zugang zum SMS-Anbieter (EU) für Fahrer-Rückfall und Alarme. Kommt in Phase 5 zum Einsatz.
SMS_API_KEY=

# Schlüsselpaar für Web-Push an die Fahrer-App. Erzeugen z. B. mit: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Derselbe Wert wie VAPID_PUBLIC_KEY, aber mit NEXT_PUBLIC_-Präfix, damit ihn der Browser lesen darf.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Schlüssel zum Verschlüsseln von Gesprächsprotokollen und Zugangsdaten (AES-256-GCM, genau 32 Byte).
# Erzeugen z. B. mit: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Geheimnis, das die Cron-Endpunkte (/api/cron/*) vor fremden Aufrufen schützt.
CRON_SECRET=

# Die öffentliche Adresse der App, z. B. http://localhost:3000 in der Entwicklung
# oder https://meine-domain.de im Betrieb.
APP_URL=http://localhost:3000
